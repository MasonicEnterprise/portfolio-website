---
const projects = [
  {
    title: "Microsoft enterprise lab",
    status: "Active",
    description:
      "A hybrid environment where on-premises Active Directory syncs to Microsoft Entra ID, with Intune enrollment and Conditional Access policies applied to test endpoints.",
    tags: ["Windows Server", "Entra ID", "Intune", "Conditional Access"],
    link: "https://github.com/MasonicEnterprise",
  },
  {
    title: "Azure infrastructure lab",
    status: "Planned",
    description:
      "Hub-and-spoke virtual networking in Azure, with role-based access control and basic cloud security baselines.",
    tags: ["Azure", "Networking", "Security"],
    link: null,
  },
  {
    title: "Linux and database lab",
    status: "Planned",
    description:
      "A Linux server running PostgreSQL, used to practice network access rules, database security, and backup and restore.",
    tags: ["Linux", "PostgreSQL", "Backups"],
    link: null,
  },
];

const skillGroups = [
  {
    name: "Identity and cloud",
    items: ["Microsoft 365", "Microsoft Entra ID", "Conditional Access"],
  },
  {
    name: "Endpoints and servers",
    items: ["Microsoft Intune", "Active Directory", "Windows Server"],
  },
  {
    name: "Networking, security, scripting",
    items: ["Networking", "Endpoint security", "PowerShell"],
  },
];

const certifications = ["CompTIA A+", "CompTIA Network+", "CompTIA Security+" , "Microsoft Certified: Azure Fundamentals (AZ-900)"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e1624" />
    <meta
      name="description"
      content="Masonic Enterprise: a hands-on IT portfolio covering Microsoft 365, Entra ID, Intune, Active Directory, and Azure."
    />
    <title>Masonic Enterprise | IT administration portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="#home">Masonic Enterprise</a>
        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#skills">Skills</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section id="home" class="hero container">
        <div class="hero-copy">
          <h1><h1>IT Infrastructure & Cloud Engineering</h1></h1>
          <p class="lead">
<p class="lead">
  Hands-on projects focused on deploying, configuring,
  securing, and managing Microsoft Azure, Microsoft 365,
  and hybrid enterprise environments.
</p>
          </p>
          <div class="actions">
            <a class="button primary" href="#projects">See projects</a>
            <a
              class="button secondary"
              href="https://github.com/MasonicEnterprise"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub profile
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </div>
        </div>

        <figure class="topology">
          <pre aria-hidden="true">Active Directory (on-premises)
        │  sync
        ▼
Microsoft Entra ID
        ├── Conditional Access
        └── Intune ──► Windows endpoints</pre>
          <figcaption>
            Lab identity flow: on-premises Active Directory syncs to Entra ID,
            which applies Conditional Access and manages endpoints through
            Intune.
          </figcaption>
        </figure>
      </section>

      <section id="about" class="section container">
        <h2>About</h2>
        <div class="prose">
<p>
    I work in IT support and administration, with a focus
    on developing my skills in cloud computing, enterprise
    infrastructure, and security.
  </p>

  <p>
    Masonic Enterprise is my personal lab and technical
    portfolio, created to gain hands-on experience with
    Microsoft Azure, Microsoft 365, Windows Server,
    Active Directory, and related technologies.
  </p>

  <p>
    The projects documented here cover infrastructure
    deployment, identity and access management, endpoint
    administration, networking, security configuration,
    and troubleshooting. Each project emphasizes practical
    implementation and documentation of real-world
    administrative tasks.
  </p>
  </div>
      </section>

      <section id="projects" class="section container">
        <h2>Projects</h2>
        <ul class="project-list">
          {projects.map((project) => (
            <li class="project">
              <div class="project-head">
                <h3>{project.title}</h3>
                <span class:list={["status", { planned: project.status === "Planned" }]}>
                  {project.status}
                </span>
              </div>
              <div class="project-body">
                <p>{project.description}</p>
                <ul class="tags" aria-label="Technologies used">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                {project.link && (
                  <a
                    class="text-link"
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View on GitHub
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="skills" class="section container">
        <h2>Skills and certifications</h2>
        <div class="skills-layout">
          <div>
            <h3>Technologies</h3>
            <dl class="skill-groups">
              {skillGroups.map((group) => (
                <div>
                  <dt>{group.name}</dt>
                  <dd>{group.items.join(", ")}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div>
            <h3>Certifications</h3>
            <ul class="cert-list">
              {certifications.map((cert) => <li>{cert}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="contact" class="section container">
        <h2>Contact</h2>
        <div class="prose">
          <p>
            My repositories and technical write-ups are on GitHub. That is the
            best place to see how I work.
          </p>
          <!-- Add an email or LinkedIn link here when you are ready to publish one. -->
        </div>
        <div class="actions">
          <a
            class="button primary"
            href="https://github.com/MasonicEnterprise"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open GitHub
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} Masonic Enterprise</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0e1624;
    --surface: #162235;
    --line: #2a3a52;
    --text: #e6ebf2;
    --muted: #a3b2c7;
    --accent: #6cb2ff;
    --accent-strong: #2f7fe0;
    --ok: #7fd9a6;
    --font-sans: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, Consolas, monospace;

    font-family: var(--font-sans);
    color: var(--text);
    background: var(--bg);
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    line-height: 1.65;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .container {
    width: min(1040px, calc(100% - 48px));
    margin-inline: auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    background: var(--accent);
    color: #06101d;
    padding: 10px 16px;
    border-radius: 6px;
    font-weight: 600;
    z-index: 20;
  }

  .skip-link:focus {
    top: 12px;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(14, 22, 36, 0.92);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }

  .nav {
    min-height: 68px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .brand {
    font-weight: 600;
    font-size: 17px;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: var(--muted);
    font-size: 15px;
    padding: 4px 0;
  }

  nav a:hover {
    color: var(--text);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    padding-block: 96px;
  }

  h1 {
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 22px;
  }

  .lead {
    font-size: 18px;
    color: var(--muted);
    max-width: 52ch;
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: 500;
    border: 1px solid transparent;
  }

  .primary {
    background: var(--accent-strong);
    color: #fff;
  }

  .primary:hover {
    background: #4a92ee;
  }

  .secondary {
    border-color: var(--line);
    color: var(--text);
  }

  .secondary:hover {
    border-color: var(--accent);
  }

  .topology {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 24px;
  }

  .topology pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    color: var(--accent);
    overflow-x: auto;
  }

  .topology figcaption {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }

  /* Sections */
  .section {
    padding-block: 72px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 68px;
  }

  h2 {
    font-size: clamp(26px, 3.5vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 600;
    margin: 0 0 28px;
  }

  h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .prose {
    max-width: 65ch;
    color: var(--muted);
    font-size: 17px;
  }

  .prose p {
    margin: 0 0 16px;
  }

  /* Projects */
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 32px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }

  .project:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .status {
    font-size: 13px;
    color: var(--ok);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 2px 10px;
  }

  .status.planned {
    color: var(--muted);
  }

  .project-body p {
    margin: 0 0 16px;
    color: var(--muted);
    max-width: 62ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags li {
    font-size: 13px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 10px;
  }

  .text-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--accent);
    font-weight: 500;
    border-bottom: 1px solid transparent;
  }

  .text-link:hover {
    border-bottom-color: var(--accent);
  }

  /* Skills */
  .skills-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
  }

  .skills-layout h3 {
    margin-bottom: 18px;
  }

  .skill-groups {
    margin: 0;
  }

  .skill-groups div {
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }

  .skill-groups dt {
    font-size: 14px;
    color: var(--muted);
  }

  .skill-groups dd {
    margin: 4px 0 0;
    font-size: 17px;
  }

  .cert-list li {
    padding-block: 14px;
    border-top: 1px solid var(--line);
    font-size: 17px;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 28px;
    font-size: 14px;
    color: var(--muted);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 64px;
    }

    .project {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .project-head {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }

    .skills-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 32px, 1040px);
    }

    .nav {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 14px;
      gap: 8px;
    }

    nav {
      flex-wrap: wrap;
      gap: 8px 20px;
    }

    .section {
      padding-block: 56px;
      scroll-margin-top: 110px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
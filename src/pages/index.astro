---
const projects = [
  {
    title: "Azure-hosted portfolio website",
    status: "Live",
    description:
      "Developed and deployed this portfolio using Astro, Azure Static Web Apps, and GitHub Actions with OIDC authentication. Configured Cloudflare DNS, HTTPS, Content Security Policy, and automated deployment workflows. Investigated issues involving pull request preview environments.",
    tags: ["Azure Static Web Apps", "GitHub Actions", "OIDC", "Cloudflare DNS", "Astro"],
    link: "https://github.com/MasonicEnterprise/portfolio-website",
    linkText: "View repository",
  },
  {
    title: "Hybrid Microsoft 365 infrastructure lab",
    status: "Active",
    description:
      "Designed and configured a hybrid lab integrating on-premises Active Directory with Microsoft Entra ID through Entra Connect Sync. Implemented Windows device enrollment and compliance policies in Intune, Windows LAPS, Group Policy, and Conditional Access policies in report-only mode.",
    tags: ["Windows Server", "Active Directory", "Microsoft Entra ID", "Intune", "Hyper-V"],
    link: "https://github.com/MasonicEnterprise/Enterprise-IT-Lab",
    linkText: "View lab documentation",
  },
  {
    title: "Technical troubleshooting and case studies",
    status: "Documented",
    description:
      "Documented technical investigations involving Microsoft Entra Connect authentication, Windows LAPS configuration, and Azure deployment workflows. Case studies cover observed symptoms, troubleshooting methods, identified causes, and verification steps.",
    tags: ["Troubleshooting", "Identity", "Endpoint management", "CI/CD"],
    link: "https://github.com/MasonicEnterprise/Enterprise-IT-Lab",
    linkText: "View documentation",
  },
];

const selectedWork = [
  {
    area: "Identity and access management",
    text: "Supported Microsoft Entra ID identity administration and Conditional Access initiatives, including license-based dynamic group membership, MFA enforcement, and authentication troubleshooting.",
  },
  {
    area: "Microsoft 365 support",
    text: "Troubleshot Microsoft 365 issues involving Exchange Online, SharePoint, OneDrive, user permissions, and account access.",
  },
  {
    area: "Network infrastructure",
    text: "Installed and replaced network infrastructure across school environments, including switches, rack equipment, and structured cabling in MDF and IDF locations.",
  },
  {
    area: "Enterprise service desk",
    text: "Provided technical support for Windows endpoints, Active Directory, and Microsoft 365 services using ServiceNow. Diagnosed incidents, followed established troubleshooting procedures, and escalated issues requiring additional investigation or elevated access.",
  },
];

const skillGroups = [
  {
    name: "Identity and access",
    items: ["Active Directory", "Microsoft Entra ID", "Entra Connect Sync", "Conditional Access", "MFA"],
  },
  {
    name: "Microsoft 365",
    items: ["Exchange Online", "SharePoint", "OneDrive", "Microsoft 365 administration"],
  },
  {
    name: "Endpoint management",
    items: ["Microsoft Intune", "Windows LAPS", "Windows compliance policies", "Defender for Endpoint"],
  },
  {
    name: "Windows infrastructure",
    items: ["Windows Server", "Group Policy", "DNS", "DHCP", "Hyper-V", "File Services"],
  },
  {
    name: "Networking",
    items: ["Network switching", "MDF/IDF infrastructure", "Structured cabling", "DNS"],
  },
  {
    name: "Cloud and development tools",
    items: ["Azure Static Web Apps", "Git", "GitHub Actions", "Cloudflare"],
  },
];

const learning = ["Azure administration (AZ-104)", "PowerShell", "Microsoft Graph", "Azure CLI", "Python"];

const certifications = [
  { name: "CompTIA A+", inProgress: false },
  { name: "CompTIA Network+", inProgress: false },
  { name: "CompTIA Security+", inProgress: false },
  { name: "Microsoft Certified: Azure Fundamentals (AZ-900)", inProgress: false },
  { name: "Microsoft Certified: Azure Administrator Associate (AZ-104)", inProgress: true },
];

const roadmap = {
  now: [
    "Studying for the Microsoft AZ-104 certification",
    "Developing PowerShell administration skills",
    "Improving documentation and deployment workflows",
  ],
  next: [
    "Azure infrastructure lab: hub-and-spoke networking, NSGs, and RBAC",
    "Azure monitoring, resource security, and cost management",
    "Additional administration and security configurations for the hybrid lab",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e1624" />
    <meta
      name="description"
      content="IT infrastructure and cloud portfolio featuring Microsoft 365, Active Directory, Microsoft Entra ID, Intune, and Azure projects."
    />
    <title>Masonic Enterprise | IT infrastructure and cloud portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="#home">Masonic Enterprise</a>
        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#skills">Skills</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section id="home" class="hero container">
        <div class="hero-copy">
          <p class="eyebrow">IT SUPPORT · SYSTEMS ADMINISTRATION · CLOUD</p>
          <h1>Building practical experience in IT infrastructure and cloud technologies.</h1>
          <p class="lead">
            I work with Microsoft 365, Windows, and identity technologies while
            developing hands-on expertise in systems administration and Azure
            through independent projects. My portfolio documents the environments
            I've built, the technologies I've implemented, and the problems I've solved.
          </p>
          <div class="actions">
            <a class="button primary" href="#projects">See projects</a>
            <a
              class="button secondary"
              href="https://github.com/MasonicEnterprise"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub profile
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </div>
        </div>

        <figure class="topology">
          <pre aria-hidden="true">Active Directory (on-premises)
  │  Entra Connect Sync · PHS
  ▼
Microsoft Entra ID
  ├─ Conditional Access (report-only)
  ├─ Windows LAPS password backup
  └─ Intune ──► Windows 11
        ├─ Hybrid joined   <span class="ok">✓ compliant</span>
        └─ Entra joined    <span class="ok">✓ compliant</span></pre>
          <figcaption class="visually-hidden">
            Lab identity flow: on-premises Active Directory syncs to Microsoft
            Entra ID with Entra Connect Sync and password hash synchronization.
            Entra ID applies Conditional Access policies in report-only mode,
            stores Windows LAPS password backups, and manages Windows 11 devices
            through Intune. Both a hybrid-joined and an Entra-joined device are
            verified compliant.
          </figcaption>
        </figure>
      </section>

      <section id="about" class="section container">
        <h2>About</h2>
        <div class="about-layout">
          <div class="prose">
            <p>
              I'm an IT professional with experience supporting enterprise
              Microsoft 365 environments, Windows endpoints, Active Directory,
              and network infrastructure. My career focus is progressing from
              technical support into systems administration, Azure infrastructure,
              and cloud security.
            </p>
            <p>
              Outside of work, I maintain a hybrid Microsoft 365 lab built on
              Windows Server, Active Directory, Microsoft Entra ID, and Intune.
              I use this environment to develop administration skills, test
              configurations, and troubleshoot issues beyond the scope of my
              day-to-day support responsibilities. I document implementation
              steps, technical challenges, and validation results on GitHub.
            </p>
          </div>

          <aside class="roadmap" aria-label="Current and planned work">
            <h3>Now</h3>
            <ul>
              {roadmap.now.map((item) => <li>{item}</li>)}
            </ul>
            <h3>Next</h3>
            <ul>
              {roadmap.next.map((item) => <li>{item}</li>)}
            </ul>
          </aside>
        </div>
      </section>

      <section id="experience" class="section container">
        <h2>Professional experience</h2>
        <p class="section-intro">
          Selected examples from IT support and network infrastructure roles,
          presented without client or employer details.
        </p>
        <ul class="work-list">
          {selectedWork.map((item) => (
            <li>
              <span class="work-area">{item.area}</span>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="projects" class="section container">
        <h2>Projects</h2>
        <ul class="project-list">
          {projects.map((project) => (
            <li class="project">
              <div class="project-head">
                <h3>{project.title}</h3>
                <span class="status">{project.status}</span>
              </div>
              <div class="project-body">
                <p>{project.description}</p>
                <ul class="tags">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                {project.link && (
                  <a
                    class="text-link"
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.linkText}
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="skills" class="section container">
        <h2>Skills and certifications</h2>
        <div class="skills-layout">
          <div>
            <h3>Technologies</h3>
            <dl class="skill-groups">
              {skillGroups.map((group) => (
                <div>
                  <dt>{group.name}</dt>
                  <dd>
                    <ul class="tags">
                      {group.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </dd>
                </div>
              ))}
              <div>
                <dt>Learning now</dt>
                <dd>
                  <ul class="tags learning">
                    {learning.map((item) => <li>{item}</li>)}
                  </ul>
                </dd>
              </div>
            </dl>
          </div>
          <div>
            <h3>Certifications</h3>
            <ul class="cert-list">
              {certifications.map((cert) => (
                <li>
                  {cert.name}
                  {cert.inProgress && <span class="status in-progress">In progress</span>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="contact" class="section container">
        <h2>Contact</h2>
        <div class="prose">
          <p>
            Interested in my projects or professional background? Explore my GitHub
            repositories for technical documentation, implementation details,
            and ongoing development work.
          </p>
          <!-- Add an email or LinkedIn link here when you are ready to publish one. -->
        </div>
        <div class="actions">
          <a
            class="button primary"
            href="https://github.com/MasonicEnterprise"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open GitHub
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} Masonic Enterprise</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0e1624;
    --surface: #162235;
    --line: #2a3a52;
    --text: #e6ebf2;
    --muted: #a3b2c7;
    --accent: #6cb2ff;
    --accent-strong: #2f7fe0;
    --ok: #7fd9a6;
    --font-sans: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, Consolas, monospace;

    font-family: var(--font-sans);
    color: var(--text);
    background: var(--bg);
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    line-height: 1.65;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .container {
    width: min(1040px, calc(100% - 48px));
    margin-inline: auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    background: var(--accent);
    color: #06101d;
    padding: 10px 16px;
    border-radius: 6px;
    font-weight: 600;
    z-index: 20;
  }

  .skip-link:focus {
    top: 12px;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(14, 22, 36, 0.92);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }

  .nav {
    min-height: 68px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .brand {
    font-weight: 600;
    font-size: 17px;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: var(--muted);
    font-size: 15px;
    padding: 4px 0;
  }

  nav a:hover {
    color: var(--text);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    padding-block: 96px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
    margin: 0 0 16px;
  }

  h1 {
    font-size: clamp(32px, 4.6vw, 50px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 22px;
  }

  .lead {
    font-size: 18px;
    color: var(--muted);
    max-width: 52ch;
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: 500;
    border: 1px solid transparent;
  }

  .primary {
    background: var(--accent-strong);
    color: #fff;
  }

  .primary:hover {
    background: #4a92ee;
  }

  .secondary {
    border-color: var(--line);
    color: var(--text);
  }

  .secondary:hover {
    border-color: var(--accent);
  }

  .topology {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 24px;
  }

  .topology pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    color: var(--accent);
    overflow-x: auto;
  }

  .topology .ok {
    color: var(--ok);
  }

  /* Sections */
  .section {
    padding-block: 72px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 68px;
  }

  h2 {
    font-size: clamp(26px, 3.5vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 600;
    margin: 0 0 28px;
  }

  h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .prose {
    max-width: 65ch;
    color: var(--muted);
    font-size: 17px;
  }

  .prose p {
    margin: 0 0 16px;
  }

  /* About */
  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  .roadmap {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 24px;
  }

  .roadmap h3 {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .roadmap ul + h3 {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .roadmap li {
    font-size: 15px;
    color: var(--muted);
    padding-block: 4px;
  }

  /* Selected work */
  .section-intro {
    margin: -12px 0 28px;
    color: var(--muted);
    font-size: 15px;
  }

  .work-list li {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 32px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }

  .work-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .work-area {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
    padding-top: 2px;
  }

  .work-list p {
    margin: 0;
    color: var(--muted);
    max-width: 62ch;
  }

  /* Projects */
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 32px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }

  .project:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .status {
    font-size: 13px;
    color: var(--ok);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 2px 10px;
  }

  .project-body p {
    margin: 0 0 16px;
    color: var(--muted);
    max-width: 62ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags li {
    font-size: 13px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 10px;
  }

  .text-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--accent);
    font-weight: 500;
    border-bottom: 1px solid transparent;
  }

  .text-link:hover {
    border-bottom-color: var(--accent);
  }

  /* Skills */
  .skills-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
  }

  .skills-layout h3 {
    margin-bottom: 18px;
  }

  .skill-groups {
    margin: 0;
  }

  .skill-groups div {
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }

  .skill-groups dt {
    font-size: 14px;
    color: var(--muted);
  }

  .skill-groups dd {
    margin: 8px 0 0;
  }

  .tags.learning li {
    border-style: dashed;
    color: var(--muted);
    background: transparent;
  }

  .cert-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
    font-size: 17px;
  }

  .status.in-progress {
    color: var(--accent);
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 28px;
    font-size: 14px;
    color: var(--muted);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 64px;
    }

    .about-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .project,
    .work-list li {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .project-head {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }

    .skills-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 32px, 1040px);
    }

    .nav {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 14px;
      gap: 8px;
    }

    nav {
      flex-wrap: wrap;
      gap: 8px 20px;
    }

    .section {
      padding-block: 56px;
      scroll-margin-top: 110px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
